{
  "name": "deedlords",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,room -c yellow,magenta \"npm:dev:web\" \"npm:dev:room\"",
    "predev:web": "npm run build:chibi",
    "dev:web": "next dev -H 0.0.0.0",
    "dev:room": "wrangler dev --ip 0.0.0.0 --port 8787 --var TOWN_DEV_AUTH:1",
    "dev:chain": "npm run build:chibi && NEXT_PUBLIC_NEAR_NETWORK=sandbox next dev",
    "dev:testnet": "npm run build:chibi && NEXT_PUBLIC_DEEDLORDS_DEV_URL=http://127.0.0.1:8792 next dev",
    "dev:server": "PORT=8790 DATA_DIR=.server-data TOWN_DEV_AUTH=1 node --env-file-if-exists=.env.local --experimental-strip-types --disable-warning=ExperimentalWarning --import ./server/register.mjs server/index.ts",
    "build": "npm run build:chibi && next build",
    "build:chibi": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-chibi.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p server",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./server/register.mjs --test tests/*.test.ts",
    "loadtest:co-ty-phu": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/co-ty-phu-bots.ts test",
    "bots:co-ty-phu": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/co-ty-phu-bots.ts join",
    "diff:gen": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/diff/gen.ts",
    "diff:check": "cargo run --release --manifest-path contracts/Cargo.toml --bin replay -- traces",
    "deploy:room": "wrangler deploy",
    "chibi:catalog": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/chibi-catalog.ts",
    "start:mainnet": "NEXT_PUBLIC_NEAR_NETWORK=mainnet DEEDLORDS_SPONSOR_ACCOUNT=free.deedlords.near POKER_SWEEP_ACCOUNT=pokersweep.deedlords.near sh -c 'npm run build:chibi && next build && next start -p 3001'"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.30.0",
    "@hot-labs/near-connect": "^0.12.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "next": "^16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.1",
    "ws": "^8.21.0"
  }
}
